# --- Required -----------------------------------------------------------------
# MongoDB Atlas connection string (hackathon sandbox cluster).
MONGODB_URI=
MONGODB_DB_NAME=homeswipe

# --- Optional: embeddings (Voyage AI by MongoDB preferred) ----------------------
VOYAGE_API_KEY=
# voyage-4 (default) or voyage-4-lite for lower latency/cost. Both output 1024 dims here.
VOYAGE_MODEL=voyage-4

# --- Optional: LLM for structured parsing / narration (OpenAI or OpenRouter) -----
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Defaults: gpt-5-mini (OpenAI) / openai/gpt-5-mini (OpenRouter)
LLM_MODEL=
# Used only when VOYAGE_API_KEY is absent and OPENAI_API_KEY is set (truncated to 1024 dims).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Optional: map ---------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Listings ----------------------------------------------------------------------
# seed (default, offline, deterministic) or rentcast (requires RENTCAST_API_KEY)
PROPERTY_PROVIDER=seed
RENTCAST_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo / harness ------------------------------------------------------------------
# Enables /lab simulation + reset outside development. Never enable on a public production
# deployment you don't control.
DEMO_MODE=true
# Automatic evolution every HARNESS_AUTO_EVOLVE_EVERY new real resolved predictions.
HARNESS_AUTO_EVOLVE=true
# HARNESS_MIN_RESOLVED=30
# HARNESS_MIN_HOLDOUT=10
# HARNESS_MIN_ACCURACY_DELTA=0.03
# HARNESS_AUTO_EVOLVE_EVERY=10
# PREFERENCE_UPDATE_EVERY=4
