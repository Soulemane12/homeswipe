{
  "name": "swipehome",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:generate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/generate-seed-data.ts",
    "seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed-properties.ts",
    "setup:indexes": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/setup-indexes.ts",
    "setup:demo": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/setup-demo-user.ts",
    "setup": "pnpm seed && pnpm setup:indexes && pnpm setup:demo",
    "simulate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/simulate.ts",
    "reset:demo": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/reset-demo.ts",
    "verify:atlas": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/verify-atlas.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "mapbox-gl": "^3.31.0",
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.15.0"
}
